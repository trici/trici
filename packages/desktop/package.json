{
  "name": "@trici/desktop",
  "productName": "TriciDev",
  "version": "0.2.0",
  "description": "The Desktop application for Trici ",
  "author": "Shashi Singh <singh.shashishekhar@gmail.com>",
  "homepage": "https://gettrici.com",
  "license": "ISC",
  "main": "src/main.js",
  "directories": {
    "dist": "dist",
    "src": "src",
    "lib": "lib",
    "test": "__tests__",
    "bin": "bin"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trici/trici.git"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "live-start": "cross-env NODE_ENV=livedev electron .",
    "esbuild-main": "node esbuild.main.js",
    "esbuild-renderer": "node esbuild.renderer.js",
    "build-live": "cross-env NODE_ENV=livedev node esbuild.renderer.live.js",
    "build-dev": "npm run esbuild-main && npm run esbuild-renderer",
    "test": "cross-env NODE_ENV=test npx playwright test",
    "updbin": "node updbin.js"
  },
  "bugs": {
    "url": "https://github.com/trici/trici/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.31.2",
    "@tanstack/eslint-plugin-query": "^4.29.9",
    "@types/electron-json-storage": "^4.5.0",
    "@types/react": "^18.2.11",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^23.1.4",
    "playwright": "^1.31.2"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@fluentui/react-components": "^9.21.0",
    "@mantine/core": "^6.0.13",
    "@mantine/hooks": "^6.0.13",
    "@tabler/icons-react": "^2.22.0",
    "@tanstack/react-query": "^4.29.19",
    "@trici/app-observer": "^1.2.0",
    "@trici/config": "^1.1.1",
    "@trici/dal": "^1.0.3",
    "@trici/logger": "^1.1.0",
    "@trici/models": "^1.1.0",
    "@trici/pm": "^0.3.2",
    "@trici/recorder": "^1.1.0",
    "@trici/utils": "^1.2.1",
    "electron-context-menu": "^3.6.1",
    "electron-is-accelerator": "^0.2.0",
    "electron-json-storage": "^4.6.0",
    "electron-unhandled": "^4.0.1",
    "loglevel": "^1.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recoil": "^0.7.7"
  }
}
