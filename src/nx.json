{
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "test",
          "build-dev"
        ]
      }
    }
  },
  "targetDefaults": {
    "build-dev": {
      "dependsOn": [
        "^build-dev"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "updbin": {
      "dependsOn": [
        "^updbin"
      ]
    }
  },
  "affected": {
    "defaultBase": "main"
  }
}
