{
  "name": "@trici/datawriter",
  "version": "1.0.0",
  "description": "JSON to Protocol Buffer converter for data writing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build-esbuild-dev": "cross-env NODE_ENV=development node esbuild.js",
    "build-esbuild-prod": "cross-env NODE_ENV=production node esbuild.js",
    "build-dev": "pnpm run build-types && npm run build-esbuild-dev",
    "build-prod": "pnpm run build-esbuild-prod",
    "build-types": "tsc && node ../../scripts/flatten-types.js .",
    "start": "node start.js",
    "test": "cross-env NODE_ENV=test jest"
  },
  "dependencies": {
    "protobufjs": "^7.2.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "cross-env": "^7.0.3"
  }
}
