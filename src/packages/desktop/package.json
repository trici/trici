{
  "name": "@trici/desktop",
  "productName": "TriciDev",
  "version": "0.11.0",
  "description": "The Desktop application for Trici ",
  "author": "Shashi Singh <singh.shashishekhar@gmail.com>",
  "homepage": "https://gettrici.com",
  "license": "ISC",
  "main": "dist/main.js",
  "directories": {
    "dist": "dist",
    "src": "src",
    "test": "__tests__",
    "bin": "bin"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trici/trici.git"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "live-start": "cross-env NODE_ENV=livedev electron .",
    "esbuild-main": "node esbuild.main.js",
    "check-types": "tsc --noEmit",
    "esbuild-renderer": "node esbuild.renderer.js",
    "build-copy-unbundled": "node copyunbundledfiles.js",
    "build-live": "concurrently \"cross-env NODE_ENV=livedev node esbuild.renderer.live.js\" \"pnpm run build-css-live\"",
    "build-dev": "cross-env NODE_ENV=development pnpm run esbuild-main && cross-env NODE_ENV=development pnpm run esbuild-renderer && pnpm run build-config-dev && pnpm run build-copy-unbundled",
    "build-prod": "cross-env NODE_ENV=production pnpm run esbuild-main && cross-env NODE_ENV=production pnpm run esbuild-renderer && pnpm run build-config-prod && pnpm run build-css && pnpm run build-copy-unbundled && pnpm run check-types",
    "build-config-dev": "cross-env NODE_ENV=development node buildConfig.js",
    "build-config-prod": "cross-env NODE_ENV=production node buildConfig.js",
    "build-css": "tailwindcss -i src/tricitailwind.css -o dist/trici.output.css",
    "build-css-live": "tailwindcss -i src/tricitailwind.css -o dist/trici.output.css --watch",
    "create-version-file": "node createVersionFile.js",
    "test": "cross-env NODE_ENV=test npx playwright test",
    "updbin": "node updbin.js",
    "sync-tests-to-build": "node syncTestsToBuild.js",
    "build-for-packaging": "run-script-os",
    "build-for-packaging:darwin": "nx affected --target=build-prod && cross-env NODE_ENV=production node updbin.js && pnpm run build-prod && pnpm run create-version-file && cross-env NODE_ENV=production node createBuildForPackaging.js",
    "postinstall": "electron-rebuild",
    "rebuild": "electron-rebuild -f"
  },
  "bugs": {
    "url": "https://github.com/trici/trici/issues"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "1.59.1",
    "@tailwindcss/cli": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@types/d3": "^7.4.3",
    "@types/electron-json-storage": "^4.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@types/video.js": "^7.3.58",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.2.0",
    "playwright": "1.59.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@singhshashi/proactive": "^0.13.0",
    "@tanstack/react-query": "^5.99.0",
    "@trici/activmon": "workspace:^",
    "@trici/app-observer": "workspace:^",
    "@trici/config": "workspace:^",
    "@trici/dal": "workspace:^",
    "@trici/datawriter": "workspace:^",
    "@trici/logger": "workspace:^",
    "@trici/models": "workspace:^",
    "@trici/pm": "workspace:^",
    "@trici/recorder": "workspace:^",
    "@trici/utils": "workspace:^",
    "@videojs/http-streaming": "^3.17.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "electron-context-menu": "^4.1.2",
    "electron-is-accelerator": "^0.2.0",
    "electron-json-storage": "^4.6.0",
    "electron-unhandled": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.3.4",
    "knex": "^3.2.9",
    "loglevel": "^1.8.1",
    "node-mac-permissions": "^2.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "uuid": "^13.0.0",
    "video.js": "^8.23.7"
  }
}
