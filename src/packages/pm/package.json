{
  "name": "@trici/pm",
  "version": "0.4.6",
  "description": "Manages the communication between the primary and secondary main processes",
  "author": "Shashi Singh <singh.shashishekhar@gmail.com>",
  "homepage": "https://github.com/trici/trici#readme",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "directories": {
    "src": "src",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trici/trici.git"
  },
  "scripts": {
    "esbuild-dev": "cross-env NODE_ENV=development node esbuild.js",
    "esbuild-prod": "cross-env NODE_ENV=production node esbuild.js",
    "build-dev": "pnpm run build-types && pnpm run esbuild-dev",
    "build-prod": "pnpm run esbuild-prod",
    "build-types": "tsc && node ../../scripts/flatten-types.js .",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles"
  },
  "bugs": {
    "url": "https://github.com/trici/trici/issues"
  },
  "devDependencies": {
    "@trici/utils": "workspace:^",
    "@types/jest": "^29.5.0",
    "cross-env": "^7.0.3",
    "jest": "^29.5.0"
  },
  "dependencies": {
    "@trici/config": "workspace:^",
    "@trici/logger": "workspace:^",
    "@trici/models": "workspace:^",
    "@types/node-ipc": "^9.2.0",
    "node-ipc": "10.1.0"
  }
}
